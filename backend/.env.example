# Server Configuration
PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API (omit in dev to allow any origin)
CORS_ORIGIN=http://localhost:5173

# Max login attempts per IP per 15 minutes (default 60)
LOGIN_RATE_LIMIT_MAX=60

# JWT Configuration (login + auth middleware both use JWT_SECRET, or SECRET as fallback)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=menahariya_smart

# After a driver is assigned to a trip, changing the driver is blocked until driver_lock_expires_at
# (min(now + N hours, departure time)). Default 24 if unset.
# DRIVER_TRIP_LOCK_HOURS=24

# ---------------------------------------------------------------------------
# Chapa — coursework / developer (sandbox) by default
# ---------------------------------------------------------------------------
# Use Chapa Dashboard → API → Secret Key that starts with CHASECK_TEST (test mode, no real money).
# Never commit real keys to git. Do NOT put CHAPUBK_ (public) in CHAPA_SECRET_KEY.
CHAPA_SECRET_KEY=CHASECK_TEST-paste-your-test-secret-here

# Optional alias:
# CHASECK_SECRET_KEY=CHASECK_TEST-...

# Webhook secret from Chapa Dashboard → Webhooks (same string you configure there).
CHAPA_WEBHOOK_SECRET=your-webhook-secret-hash-from-dashboard

CHAPA_BASE_URL=https://api.chapa.co

# Default true: marks integration as test/sandbox in config responses. Set false only for real production.
CHAPA_TEST_MODE=true

# School project default: LIVE keys (CHASECK_LIVE) are REJECTED unless you set this to true.
# Do not enable for class demos — use CHASECK_TEST only.
CHAPA_ALLOW_LIVE_KEYS=false

# Optional: override callback URL used when initializing payments.
# CHAPA_CALLBACK_URL=https://your-api.com/api/payments/chapa/callback

# Application URLs (match your Express port, often 5000 with Vite proxy)
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Shown as issuer name in authenticator apps (two-step verification setup QR)
# APP_DISPLAY_NAME=Menahariya Smart

# ---------------------------------------------------------------------------
# Email OTP (passenger sign-up, two-step verification enable/disable/login)
# ---------------------------------------------------------------------------
# OTP emails are sent through SMTP in all environments when SMTP is configured.
# If SMTP_HOST / SMTP_USER / SMTP_PASS are missing, OTPs fall back to API-console logging.
#
# Force console OTP even when SMTP is set (all flows):
# PASSENGER_OTP_LOG_ONLY=1
# EMAIL_LOG_ONLY=1
#
# Fail hard on SMTP errors (default is graceful console fallback on SMTP send failure):
# SMTP_FORCE_SEND=1
#
# Gmail (error 535 BadCredentials): Google does NOT accept your normal password here.
# 1) Turn on 2-Step Verification for the Google account.
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) SMTP_USER=youraddress@gmail.com  SMTP_PASS=16-char app password (no spaces)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Menahariya Smart <noreply@example.com>"
# PASSENGER_REGISTER_START_RATE_LIMIT_MAX=8
# PASSENGER_REGISTER_VERIFY_RATE_LIMIT_MAX=40
#
# Keep database up to date with backend/database/menahariya_smart_full_schema.sql

# Cargo Fee Configuration
CARGO_FEE_BASE=0
CARGO_FEE_PER_KG=15
#  how to calculate the cargo fee base on the weight? give the formula
CARGO_FEE_FORMULA=0 + (weight * 15)

# how to calculate the cargo fee base on the weight? give the formula
CARGO_FEE_FORMULA=0 + (weight * 15)

# how to calculate the cargo fee base on the weight? give the formula
CARGO_FEE_FORMULA=0 + (weight * 15)

# how to calculate the cargo fee base on the weight? give the formula
CARGO_FEE_FORMULA=0 + (weight * 15)
 
 
