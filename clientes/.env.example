# Production: full API URL (no trailing slash). Dev uses Vite proxy to localhost:5000.
# VITE_API_URL=https://api.example.com

# Admin registration sends this roles.id (default 1). Match your MySQL `roles` table.
# VITE_ADMIN_ROLE_ID=1

# Public passenger registration (`/register`). Schema default: 3 = passenger (2 = driver).
# VITE_PASSENGER_ROLE_ID=3
